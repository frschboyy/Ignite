<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link rel="stylesheet" href="/css/aboutus.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
  <title>ABOUT US</title>
</head>

<body>
  <!-- Header -->
  <header class="header">
    <a href="/home-page" id="logo">Youth<span>Ignite</span></a>
    <nav class="navbar">
      <ul>
        <li><a href="/home-page">Home</a></li>
        <li><a href="/about-us" class="active">About Us</a></li>
        <li><a href="/booking-form">Donate</a></li>
        <li><a href="/contact-us">Contact Us</a></li>
        <li id="signup"><a href="/sign-up">Sign Up</a></li>
        <li id="logout"><a href="/logout">Logout</a></li>
      </ul>
    </nav>
  </header>

  <!-- Home -->
  <section id="hero">
    <div class="hero-content">
      <h3 style="font-size: 48px">Make a Difference Today</h3>
      <b>
      <p style="color: #ff8503; font-size: 28px">Your support can transform lives and empower those in need.<br>Contribute to our cause and be a part of something meaningful.</p>
      </b>
      <a href="/booking-form" class="hero-button">Donate Now</a>
    </div>
    <div class = "solid_img"></div>
  </section>

  <!-- About Us Section -->
  <section id="about-us">
      <div class="about-us-container">
          <div class="about-us-text">
              <h2>About Us</h2>
              <hr>
              <p>In Arusha, Tanzania, 60% of youth are neither enrolled in school nor engaged in employment, perpetuating cycles of poverty and exposing many young girls to risks such as substance abuse, exploitation in commercial sex work, and involvement in criminal activities. Youth Ignite is dedicated to changing this narrative by empowering young girls through soccer.</p>
          </div>
      </div>
  </section>
  
  <!--- Mission -->
  <section id="mission-statement">
    <div class="mission-description">
      <h2>Mission</h2><br>
      <p style="text-align:center">Our mission is to catalyze girls' empowerment through an innovative fusion of:</p>
      <br>
      <ul class="icon-list">
        <li><i class="fas fa-futbol"></i>Elite soccer training</li>
        <li><i class="fas fa-chalkboard-teacher"></i>Empowerment workshops</li>
        <li><i class="fas fa-lightbulb"></i>Entrepreneurial incubation</li>
        <li><i class="fas fa-users"></i>Community leadership projects</li>
        <li><i class="fas fa-leaf"></i>Eco-activism initiatives</li>
      </ul>
    </div>
    <br>
    <div class="support-description">
      <p style="text-align:center; color:#09c012; font-weight:bold">We provide comprehensive support that includes educational and vocational opportunities, fostering a sense of community, and nurturing talent in an eco-friendly environment.</p>
    </div>
  </section>

  <!-- Value Proposition Section -->
  <section id="value-proposition">
      <div class="value-proposition-container">
          <h2>Our Value Proposition</h2>
          <div class="vp_img">
            <img src="../images/vp_img.png">
          </div>
          <div class="value-proposition-grid">
              <div class="value-item">
                  <h3>Alleviating</h3>
                  <p>Alleviating the pain of exploitation and risky behaviors.</p>
              </div>
              <div class="value-item">
                  <h3>Empowering</h3>
                  <p>Empowering girls through sports and life skills.</p>
              </div>
              <div class="value-item">
                  <h3>Providing</h3>
                  <p>Providing educational and vocational opportunities.</p>
              </div>
              <div class="value-item">
                  <h3>Fostering</h3>
                  <p>Fostering a sense of community and belonging.</p>
              </div>
              <div class="value-item">
                  <h3>Nurturing</h3>
                  <p>Nurturing talent in an eco-friendly climate.</p>
              </div>
          </div>
      </div>
  </section>

  <!-- Market Section -->
  <section id="market">
      <div class="market-container">
        <div class="market-container">
            <h2>Our Market</h2>
            <br>
            <p style="text-align: center">We focus on reaching different regions in and around Arusha, Tanzania</p>
            <br>
            <canvas id="marketChart" width="600" height="600" style="align-self: center"></canvas>
            <p style="text-align: center; color:#09c012; font-weight: bold">Our goal is to engage 1% of the population, translating to 6,000 customers.</p>
        </div>
      </div>
  </section>

  <!-- Revenue Generation Section -->
  <section id="revenue-generation">
      <div class="revenue-generation-container">
          <h2>Revenue Generation</h2>
          <p>Our revenue streams include:</p>
          <ul>
              <li>Program fees</li>
              <li>Sponsorships from companies like Coca-Cola, Adidas, and Nike</li>
              <li>Government grants</li>
              <li>Donations</li>
          </ul>
          <p>We also engage men's teams to support our cause by paying fees for training sessions and matches.</p>
      </div>
  </section>

  <!-- Team Section -->
  <section id="team">
      <div class="team-container">
          <h2>Our Team</h2>
          <p class="contact-text">Brenda Francis Simba leads the initiative as the Founder, working alongside a management team that includes core athletes and renowned soccer legends. Our team is dedicated to empowering young girls and paving the way for a brighter, more promising future.</p>
          <img src="images/simba.jpg" class="contact-image">
      </div>
  </section>

  <!-- Contact Us -->
  <section id="contact">
    <div class="container">
      <p><b>For inquiries or bookings, please get in touch with our team.</b></p>
      <br>
      <a href="/contact-us" class="contact-button">Contact Now</a>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2024 Youth Ignite. All rights reserved.</p>
  </footer>

  <script src="js/validate.js"></script>
  <script src="js\marketChart.js"></script>
</body>
</html>