<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewpor  0t" content="width=device-width, initial-scale=1.0">
  <title>Contact Us - Youth Ignite</title>
  <link rel="stylesheet" type="text/css" href="/css/contactus.css">
  <link rel="stylesheet" href="/css/navigation.css">
</head>

<body>
  <!-- Header -->
  <header class="header">
    <a href="/home-page" id="logo">Youth<span>Ignite</span></a>
    <nav class="navbar">
      <ul>
        <li><a href="/home-page">Home</a></li>
        <li><a href="/about-us">About Us</a></li>
        <li><a href="/donation-form">Donate</a></li>
        <li><a href="/contact-us" class="active">Contact Us</a></li>
      </ul>
    </nav>
  </header>

  <!-- Main Content -->
  <main>
    <section id="contact">
      <div class="container">
        <h2>Contact Us</h2>
        <p>If you have any questions or inquiries, feel free to get in touch with us.</p>
        <form id="contact-form">
          <input type="text" id="name" name="name" placeholder="Your name"><br><br>
          <input type="email" id="email" name="email" placeholder="Your email" required><br><br>
          <textarea id="message" name="message" placeholder="Your message" required></textarea>
          <input type="submit" value="Submit">
        </form>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer>
    <p>&copy; 2024 Youth Ignite. All rights reserved.</p>
  </footer>

  <script src="js/validate.js"></script>
  <script src="/js/contactus.js"></script>
</body>

</html>