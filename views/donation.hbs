<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donate to Youth Ignite</title>
  <link rel="stylesheet" href="/css/donation.css">
  <link rel="stylesheet" href="/css/navigation.css">
</head>

<body>
  <!-- Header -->
  <header class="header">
    <a href="/home-page" id="logo">Youth<span>Ignite</span></a>
    <nav class="navbar">
      <ul>
        <li><a href="/home-page">Home</a></li>
        <li><a href="/about-us">About Us</a></li>
        <li><a href="/donation-form" class="active">Donate</a></li>
        <li><a href="/contact-us">Contact Us</a></li>
      </ul>
    </nav>
  </header>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1>Support Our Cause</h1>
      <p>Make a difference by donating to empower our youth. Your generosity helps us create a brighter future.</p>
    </div>
  </section>

  <!-- Donations Section -->
  <section class="donations">
    <div class="container">
      <h2>How to Donate</h2>
      <div class="donation-instructions">
        <p>
          Use the following Paybill details to send your donation:
        </p>
        <div class="paybill-info">
          <p><strong>Paybill Number:</strong> <span>123456</span></p>
          <p><strong>Account Name:</strong> YouthIgniteDonation</p>
        </div>
        <p>Steps to donate:</p>
        <ol>
          <li>Open the M-Pesa menu on your phone.</li>
          <li>Choose <strong>Lipa na M-Pesa</strong>.</li>
          <li>Select <strong>Paybill</strong>.</li>
          <li>Enter the Paybill Number: <strong>123456</strong>.</li>
          <li>Enter the Account Name: <strong>YouthIgniteDonation</strong>.</li>
          <li>Enter the amount you wish to donate.</li>
          <li>Complete the transaction by entering your PIN.</li>
        </ol>
        <p>Thank you for your support!</p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="container">
      <p>&copy; 2024 Youth Ignite. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/donate.js"></script>
</body>

</html>
